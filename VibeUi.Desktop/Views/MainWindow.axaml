<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VibeUi.Desktop.ViewModels"
        xmlns:views="using:VibeUi.Desktop.Views"
        x:Class="VibeUi.Desktop.Views.MainWindow" x:DataType="vm:ShellViewModel"
        Title="Vibe UI" Width="1280" Height="820" MinWidth="820" MinHeight="520"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" RequestedThemeVariant="Dark">
    <Grid Name="Columns" ColumnDefinitions="248,Auto,*,Auto,Auto">
        <views:SidebarView Grid.Column="0" Name="Sidebar" />
        <GridSplitter Grid.Column="1" Width="1" Background="{StaticResource LineBrush}" ResizeDirection="Columns" />

        <!-- Centre: the selected thread, or a state screen -->
        <Panel Grid.Column="2">
            <ContentControl Name="ThreadHost" Content="{Binding SelectedThread}" IsVisible="{Binding ShowThread}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:ThreadViewModel">
                        <views:ThreadView />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <!-- Empty state: no projects -->
            <StackPanel Name="EmptyState" IsVisible="{Binding ShowEmptyState}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="440">
                <TextBlock Text="No projects yet" Classes="title" TextAlignment="Center" />
                <Button Content="Add a folder…" Classes="primary" HorizontalAlignment="Center" Click="AddProjectClick" />
            </StackPanel>

            <!-- Not installed -->
            <StackPanel Name="InstallPanel" IsVisible="{Binding ShowInstall}" Spacing="12" MaxWidth="560" VerticalAlignment="Center">
                <TextBlock Text="Mistral Vibe is not installed" Classes="title" TextAlignment="Center" />
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Classes="muted" Text="Install it, then connect again. Or set the path in Settings." />
                <SelectableTextBlock Text="{Binding InstallCommand}" Classes="mono" HorizontalAlignment="Center" />
                <Button Content="Connect again" Classes="outline" Command="{Binding ReconnectCommand}" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Sign in -->
            <StackPanel Name="SignInPanel" IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ShowSignIn}" Spacing="16" MaxWidth="480" VerticalAlignment="Center" HorizontalAlignment="Center"
                        DataContext="{Binding ActiveConnection}" x:DataType="vm:AgentConnection">
                <Button Name="SignInButton" Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).SignInCommand}" IsVisible="{Binding !IsSigningIn}"
                        Width="144" Height="144" HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16"
                        AutomationProperties.Name="Sign in to Mistral">
                    <StackPanel Spacing="16">
                        <Canvas Width="70" Height="50" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <Path Fill="#FFD700" Data="M10,0 H20 V10 H10 Z M50,0 H60 V10 H50 Z" />
                            <Path Fill="#FFAF00" Data="M10,10 H30 V20 H10 Z M40,10 H60 V20 H40 Z" />
                            <Path Fill="#FF8205" Data="M10,20 H60 V30 H10 Z" />
                            <Path Fill="#FA500F" Data="M10,30 H20 V40 H10 Z M30,30 H40 V40 H30 Z M50,30 H60 V40 H50 Z" />
                            <Path Fill="#E10500" Data="M0,40 H30 V50 H0 Z M40,40 H70 V50 H40 Z" />
                        </Canvas>
                        <TextBlock Text="Sign in" FontSize="15" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSigningIn}" Height="3" />
                <TextBox Text="{Binding SignInUrl}" IsReadOnly="True" TextWrapping="Wrap" IsVisible="{Binding HasSignInUrl}" AutomationProperties.Name="Sign-in link" />
                <Button Content="Open the link again" Classes="ghost" Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).OpenSignInUrlCommand}"
                        IsVisible="{Binding HasSignInUrl}" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Agent failed or exited -->
            <StackPanel Name="ConnectPanel" IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ShowConnect}" Spacing="12" MaxWidth="480" VerticalAlignment="Center"
                        DataContext="{Binding ActiveConnection}" x:DataType="vm:AgentConnection">
                <TextBlock Text="{Binding AgentDescription}" Classes="title" TextAlignment="Center" />
                <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsStarting}" Height="3" />
                <Button Content="Connect" Classes="outline" Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ReconnectCommand}"
                        HorizontalAlignment="Center" IsVisible="{Binding !IsStarting}" />
            </StackPanel>

            <!-- Settings -->
            <Border Name="SettingsPanel" IsVisible="{Binding IsSettingsVisible}" Background="{StaticResource BgBrush}">
                <StackPanel MaxWidth="560" Margin="32" Spacing="18" VerticalAlignment="Top">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Settings" Classes="title" />
                        <Button Grid.Column="1" Classes="icon" Content="✕" Command="{Binding ToggleSettingsCommand}" AutomationProperties.Name="Close settings" />
                    </Grid>
                    <StackPanel Spacing="6">
                        <TextBlock Text="vibe-acp executable" Classes="section" />
                        <TextBox Text="{Binding VibeExecutable}" PlaceholderText="Leave empty to use PATH" AutomationProperties.Name="Vibe executable" />
                        <TextBlock Text="{Binding ResolvedExecutable, StringFormat='Using: {0}'}" Classes="faint" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Briefing interval (minutes)" Classes="section" />
                        <NumericUpDown Value="{Binding BriefingMinutes}" Minimum="1" Maximum="120" Increment="1" FormatString="0" Width="140" HorizontalAlignment="Left" AutomationProperties.Name="Briefing minutes" />
                        <TextBlock Text="How often a running Chief of Staff task reports back." Classes="faint" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Show" Classes="section" />
                        <CheckBox Content="Model thoughts" IsChecked="{Binding ShowThoughts}" />
                        <CheckBox Content="Changes pane" IsChecked="{Binding IsChangesVisible}" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Data" Classes="section" />
                        <SelectableTextBlock Text="{Binding DataDirectory}" Classes="mono" />
                        <TextBlock Text="Threads, transcripts and task worktrees live here." Classes="faint" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Shortcuts" Classes="section" />
                        <TextBlock Classes="muted" Text="⌘N thread · ⌘⇧N orchestrator · ⌘⇧O add project · ⌘D changes · ⌘⇧T thoughts · ⌘, settings · Esc stop" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- A project but no thread selected -->
            <StackPanel Name="NoThreadPanel" IsVisible="{Binding ShowNoThread}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <TextBlock Text="No thread" Classes="title" TextAlignment="Center" />
                <Button Content="New thread" Classes="primary" HorizontalAlignment="Center" Command="{Binding NewThreadCommand}" />
            </StackPanel>
        </Panel>

        <GridSplitter Grid.Column="3" Width="1" Background="{StaticResource LineBrush}" ResizeDirection="Columns" IsVisible="{Binding ShowChangesPane}" />
        <views:ChangesView Grid.Column="4" Name="Changes" Width="380" DataContext="{Binding ActiveChanges}" IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ShowChangesPane}" />
    </Grid>
</Window>
